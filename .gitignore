# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root — patterns are unanchored so they match in client/, server/, etc.

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing / coverage
coverage/

# next.js
.next/
out/

# production builds
build/
dist/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (server/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
