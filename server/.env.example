# Copy to .env and fill in. Never commit the real .env.
ENVIRONMENT=development

# Postgres (async driver). In Docker this points at the postgres service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/findplace

# JSON array — origins allowed to call the API (the Next.js client).
CORS_ORIGINS=["http://localhost:3050"]

# --- Added as features land ---
# ANTHROPIC_API_KEY=            # AI search (Claude)
# CLOUDINARY_URL=               # image uploads
# JWT_SECRET=                   # auth token signing
